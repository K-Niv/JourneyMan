# ==============================================================================
# JourneyMan — Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (PostgreSQL via Neon / Supabase / Railway)
# Example Neon URL format:
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/journeyman?sslmode=require"

# Authentication & Security (JWT)
# IMPORTANT: Generate a 64+ char random string in production (e.g. `openssl rand -base64 48`)
JWT_SECRET="super-secret-jwt-key-change-in-production"

# CORS & Client Configuration
# Comma-separated list of allowed client origins for production
CLIENT_URL="http://localhost:5173"

# Rate Limiting (Optional Overrides)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GENERAL_MAX=300
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_GUESS_MAX=45
