# Server Config
PORT=3001
NODE_ENV=development

# Database Config (PostgreSQL via Neon)
# Get this from: https://neon.tech → your project → Connection Details
# Example Neon URL format:
DATABASE_URL="postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/journeyman?sslmode=require"

# Auth Secret (JWT) — change this to a long random string in production
JWT_SECRET="super-secret-jwt-key-change-in-production"
