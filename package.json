{
  "name": "journeyman-monorepo",
  "private": true,
  "version": "1.0.0",
  "description": "JourneyMan — Daily NBA Puzzle Game",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "start": "node server/src/index.js",
    "start:server": "npm run start --workspace=server",
    "build": "npm run build --workspace=client",
    "lint": "eslint . --ext .js,.jsx",
    "format": "prettier --write .",
    "test": "npm run test --workspace=shared && npm run test --workspace=server && npm run test --workspace=client",
    "check": "npm run lint && npm test && npm run build",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset --schema=./prisma/schema.prisma",
    "generate-puzzles": "node scripts/generate-puzzles.js",
    "generate-secret": "node scripts/generate-jwt-secret.js"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.1",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "prisma": "^5.14.0"
  }
}
